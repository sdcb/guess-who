// 单个 Worker：Vite 构建的静态页面 + 每个房间一个 Durable Object，绑定 guess.sdcb.ai
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guess-who",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // 按 IP 限流：建房每分钟 5 次；连接/取语音每分钟 60 次
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "routes": [{ "pattern": "guess.sdcb.ai", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
